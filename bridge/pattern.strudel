// @title Learning
// @by Nick

samples('http://localhost:5432/')
$percussion: s("bd:1!4").echo(1,2,3).postgain(slider(0.685,0,1))
  .pan(rand)
  .mask("<1@7 0 1@3 0@2 1>")
  ._scope()
$drop: s("<nxbd:1 ~ ~ ~ >").gain(1.5).postgain(slider(0.653,0,1))
._scope()
$newv: s("<scan ~ ~ ~ >").gain(1.5)
  .mask("<1 0@16>").postgain(slider(1,0,1))
._scope()
$bass: n("0".add(-14, -18, -7)).scale("g:minor")
  .s("supersaw") // .trancegate(1.5,45,1)
  .seg(16)
  .rlpf(slider(0.641,0,1)).lpenv(2)
  .mask("<1@7 0@2 1@5>")
  .s("supersaw").trancegate(1.5,45,1)
  .rlpf(slider(0.537,0,1)).lpenv(2)
  .delay(.7).pan(rand).gain(slider(1.28,0,2))
  ._pianoroll()
$harmony: n("<[-7 2 3 3 -5 -2 2 1 2 5 3 7 5 2 3 1 -3] ~ [ 2 3 3 -5 2 1 2 5 3 7 5 2 3 1 -3]>".add(7)).scale("g:minor")
  .s("supersaw").trancegate(1.5,45,1)
  .rlpf(slider(0.495,0,1)).lpenv(slider(1.241,.5,2))
  .delay(.5).pan(rand)
  .gain(slider(1))
  .mask("<1 0>")

// $: s("pulse!16".add("<0 7 0 0 -14 0 >")).pan(rand).gain(slider(293,0,2)
// .mask("<1@2>")

$pulse: s("sawtooth!16")
  .pan(rand)
  .mask("<1@4 0@2 1@3 0@5>")
  .gain(slider(1.116,0,2))

$voice: s("<fmv ~>").mask("<1 0@18>").delay(.7).room(.8).postgain(slider(1,0,1))